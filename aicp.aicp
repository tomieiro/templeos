@aicp version=1
@stack name=templeos language=HolyC,asm host=Linux
@agent source=src docs=docs tools=tools
@mod path=deps/holylua role=lua-runtime dependency=git-submodule
@mod path=bootstrap role=historical-bootstrap dependency=generated-artifacts
@inv id=hcc status=external evidence=read_me.txt claim=HolyC validation requires hcc from holyc-lang
@inv id=naming status=enforced evidence=git-files claim=file names use snake_case and directory names use lowercase
@mod path=src/kernel role=kernel entry=src/kernel/kernel.prj
@mod path=src/compiler role=compiler
@mod path=src/adam role=system
@mod path=src/apps role=applications
@surface path=src/apps/lua_interpreter.hc name=lua-interpreter-entry invocation=include
@mod path=src/demo role=examples
@mod path=src/misc role=utilities
@mod path=tools/linux role=host-tools
@surface path=tools/linux/redsea.py name=redsea-image-generator invocation=python3
@inv id=holy-c-build status=external evidence=read_me.txt claim=HolyC requires the TempleOS compiler
@inv id=generated-files status=ignored evidence=.gitignore claim=build outputs and logs are not tracked
@inv id=bootstrap-seed status=partial evidence=bootstrap/README.md claim=V5.03 boot, kernel, compiler, and compressed RedSea startup artifacts rebuild an ISO that initializes the kernel without using the base ISO as a build input
@resolver id=kernel-build path=src/kernel/kernel.prj note=build from within TempleOS
@resolver id=linux-tools path=makefile command=make
@resolver id=bootstrap-check path=makefile command="find bootstrap -type f -print; file bootstrap/templeos-2013/0000boot/* bootstrap/templeos-2013/compiler/compiler.bin"
@resolver id=redsea-image path=makefile command="make redsea-image"
@resolver id=redsea-qemu path=makefile command="make redsea-image && qemu-system-x86_64 -m 512M -cdrom build/templeos-redsea.iso -boot d"
@task id=maintain-map action=update-on-structure-change
