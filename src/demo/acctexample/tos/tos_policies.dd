$LK,"/demo/games/elephant_walk.hc",A="FI:::/demo/games/elephant_walk.hc"$
$LK,"/demo/games/flap_bat.hc",A="FI:::/demo/games/flap_bat.hc"$
$LK,"/demo/games/flat_tops.hc",A="FI:::/demo/games/flat_tops.hc"$
$LK,"/demo/games/halogen.hc",A="FI:::/demo/games/halogen.hc"$
$LK,"/demo/games/mass_spring.hc",A="FI:::/demo/games/mass_spring.hc"$
$LK,"/demo/games/maze.hc",A="FI:::/demo/games/maze.hc"$
$LK,"/demo/games/rain_drops.hc",A="FI:::/demo/games/rain_drops.hc"$
$LK,"/demo/games/raw_hide.hc",A="FI:::/demo/games/raw_hide.hc"$
